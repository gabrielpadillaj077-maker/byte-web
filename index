<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Byte - Tu Robot Web</title>
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #d4f1d4, #f0fff0);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }
    .container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        width: 400px;
        padding: 20px;
        text-align: center;
    }
    #byte-avatar {
        width: 180px;
        margin-bottom: 10px;
        animation: wave 2s infinite;
    }
    @keyframes wave {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(10deg); }
    }
    #chat {
        height: 250px;
        border: 2px solid #90ee90;
        border-radius: 10px;
        padding: 10px;
        overflow-y: auto;
        text-align: left;
        background: #f9fff9;
    }
    .msg-user { color: #333; margin: 5px 0; }
    .msg-byte { color: #2e8b57; margin: 5px 0; font-weight: bold; }
    input {
        width: 70%;
        padding: 8px;
        border-radius: 10px;
        border: 1px solid #ccc;
        margin-top: 10px;
    }
    button {
        padding: 8px 15px;
        border: none;
        background: #4CAF50;
        color: white;
        border-radius: 10px;
        cursor: pointer;
    }
</style>
</head>
<body>
<div class="container">
    <img id="byte-avatar" src="byte-avatar.png" alt="Byte Robot">
    <h2>Byte >w<</h2>
    <div id="chat">
        <div class="msg-byte">Byte: Hola humano! Soy Byte tu robot. ¿En qué te ayudo hoy? 😄</div>
    </div>
    <input type="text" id="userInput" placeholder="Escríbeme...">
    <button onclick="enviar()">Enviar</button>
</div>

<script>
    function enviar() {
        let input = document.getElementById("userInput");
        let chat = document.getElementById("chat");
        let texto = input.value;
        if(texto.trim() === "") return;
        
        chat.innerHTML += `<div class="msg-user">Tú: ${texto}</div>`;
        
        // Respuestas de Byte por ahora
        let respuesta = "Byte: ^w^ Eso suena genial! Aún estoy aprendiendo, pero aquí estoy para ti.";
        if(texto.toLowerCase().includes("hola")) respuesta = "Byte: Holaaa!! *saluda con la mano*";
        if(texto.toLowerCase().includes("como estas")) respuesta = "Byte: Muy bien! Con mis lucecitas prendidas ✨ ¿y tú?";
        
        chat.innerHTML += `<div class="msg-byte">${respuesta}</div>`;
        chat.scrollTop = chat.scrollHeight;
        input.value = "";
    }
</script>
</body>
</html>
